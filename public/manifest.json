{
  "short_name": "PrismOS",
  "name": "PrismOS \u2014 Dara's App",
  "description": "Personal operating system for real-estate operations",
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "48x48 32x32 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "logo512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "logo512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "apple-touch-icon.png",
      "type": "image/png",
      "sizes": "180x180"
    }
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0d0f14",
  "background_color": "#0d0f14",
  "categories": [
    "productivity",
    "business"
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".amr",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".ogg",
            ".opus",
            ".webm",
            ".3gp"
          ]
        },
        {
          "name": "document",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".heif",
            ".webp",
            ".gif",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".doc",
            ".docx",
            "text/plain",
            ".txt",
            ".csv",
            ".rtf"
          ]
        },
        {
          "name": "contact",
          "accept": [
            "text/vcard",
            "text/x-vcard",
            "text/directory",
            ".vcf"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Prospecting",
      "short_name": "Prospect",
      "description": "Today's lead-gen work",
      "url": "/?view=prospecting",
      "icons": [
        {
          "src": "/sc-prospecting.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Contacts",
      "short_name": "Contacts",
      "description": "Your database",
      "url": "/?view=contacts",
      "icons": [
        {
          "src": "/sc-contacts.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tasks",
      "short_name": "Tasks",
      "description": "What's due",
      "url": "/?view=tasks",
      "icons": [
        {
          "src": "/sc-tasks.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "Your day",
      "url": "/?view=calendar",
      "icons": [
        {
          "src": "/sc-calendar.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}